PORT=5000
MONGODB_URI=mongodb://localhost:27017/soembark
CLIENT_ORIGIN=http://localhost:5173

# A long random string. Anyone with this can read/update inquiries.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional. If unset, the API still works but only logs emails to the server console.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxx_your_key_here

# Where the notification emails go and what they appear to come from.
NOTIFY_TO=hello@soembark.com
NOTIFY_FROM=SoEmbark <noreply@soembark.com>
